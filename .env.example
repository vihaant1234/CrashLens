# OpenRouter API Key Pool (3-key autonomous failover; server-side only)
OPENROUTER_API_KEY_1=sk-or-v1-replace-with-key-one
OPENROUTER_API_KEY_2=sk-or-v1-replace-with-key-two
OPENROUTER_API_KEY_3=sk-or-v1-replace-with-key-three

# Optional model preference labels for deployment environments
NEXT_PUBLIC_PRIMARY_MODEL=inception/mercury-decide:free
NEXT_PUBLIC_SECONDARY_MODEL=liquid/lfm-2.5-2.6b:free
